#!/bin/sh
# ps5block - PlayStation 5 system update blocker for OpenWrt (nftables / fw4)
# https://github.com/ (see README)  License: MIT
#
# Own nftables table "inet ps5block" with hooks that run BEFORE podkop
# (mangle -150) and independent of zapret, so neither proxying nor DPI
# bypass can carry console update traffic around the block.

VERSION="1.0.0"
TABLE="ps5block"
SHARE="/usr/share/ps5block"
OUI_FILE="$SHARE/oui.txt"
STATE_DIR="/var/run/ps5block"
DNS_STATE="/etc/ps5block.dns"
CRON_FILE="/etc/crontabs/root"
CRON_TAG="#ps5block"
LEASES="${PS5BLOCK_LEASES:-/tmp/dhcp.leases}"
ARP="${PS5BLOCK_ARP:-/proc/net/arp}"

# Update server naming: <d|f|h><region>01.ps5.update.playstation.net
REGIONS="au br cn eu hk jp kr mx ru sa tw uk us"
PREFIXES="d f h"
TEST_HOST="dus01.ps5.update.playstation.net"

# Public DNS / DoH / DoT resolvers (blocked for consoles when block_doh=1)
DOH4="1.1.1.1 1.0.0.1 1.1.1.2 1.0.0.2 1.1.1.3 1.0.0.3 8.8.8.8 8.8.4.4 9.9.9.9 149.112.112.112 9.9.9.10 149.112.112.10 9.9.9.11 149.112.112.11 94.140.14.14 94.140.15.15 94.140.14.15 94.140.15.16 94.140.14.140 94.140.14.141 208.67.222.222 208.67.220.220 208.67.222.123 208.67.220.123 77.88.8.8 77.88.8.1 77.88.8.88 77.88.8.2 77.88.8.7 77.88.8.3 76.76.2.0 76.76.10.0 185.228.168.9 185.228.169.9 185.228.168.168 185.228.169.168 45.90.28.0 45.90.30.0 194.242.2.2 194.242.2.3 101.101.101.101 223.5.5.5 223.6.6.6 119.29.29.29 180.76.76.76 64.6.64.6 64.6.65.6 156.154.70.1 156.154.71.1 4.2.2.1 4.2.2.2 8.26.56.26 8.20.247.20 84.200.69.80 84.200.70.40 193.110.81.0 185.253.5.0 76.223.122.150 76.76.19.19"
DOH6="2606:4700:4700::1111 2606:4700:4700::1001 2606:4700:4700::1112 2606:4700:4700::1002 2606:4700:4700::1113 2606:4700:4700::1003 2001:4860:4860::8888 2001:4860:4860::8844 2620:fe::fe 2620:fe::9 2620:fe::10 2620:fe::fe:10 2620:fe::11 2620:fe::fe:11 2a10:50c0::ad1:ff 2a10:50c0::ad2:ff 2a10:50c0::1:ff 2a10:50c0::2:ff 2620:119:35::35 2620:119:53::53 2a02:6b8::feed:0ff 2a02:6b8:0:1::feed:0ff 2a02:6b8::feed:bad 2a02:6b8:0:1::feed:bad 2606:1a40::2 2606:1a40:1::2 2a07:a8c0:: 2a07:a8c1:: 2a07:e340::2 2a07:e340::3 2a0d:2a00:1::2 2a0d:2a00:2::2"

[ -f /lib/functions.sh ] && . /lib/functions.sh
[ -f /usr/share/libubox/jshn.sh ] && . /usr/share/libubox/jshn.sh

# ----------------------------------------------------------------- helpers --
say() { [ -n "$QUIET" ] || echo "ps5block: $*"; }
log() { logger -t ps5block "$*" 2>/dev/null; say "$*"; }

cfg() {
	local v
	v="$(uci -q get "ps5block.main.$1")"
	[ -n "$v" ] && echo "$v" || echo "$2"
}

# effective state of a protection layer for the current mode
layer() {
	local mode def
	mode="$(cfg mode mac)"
	case "$1" in
		dns_block) cfg dns_block 1; return ;;
	esac
	if [ "$mode" = "global" ]; then
		def=0; [ "$1" = "force_dns" ] && def=1
		cfg "global_$1" "$def"
	else
		cfg "$1" 1
	fi
}

join_comma() { awk 'NF { printf "%s%s", (n++ ? ", " : ""), $0 }'; }
lower() { tr 'ABCDEF' 'abcdef'; }
table_exists() { nft list table inet "$TABLE" >/dev/null 2>&1; }

valid_mac() { echo "$1" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; }

with_lock() {
	if command -v lock >/dev/null 2>&1; then
		lock /var/lock/ps5block.lock
		"$@"; local rc=$?
		lock -u /var/lock/ps5block.lock
		return $rc
	fi
	"$@"
}

# --------------------------------------------------------- console detect --
# prints: mac ip hostname how(oui|hostname) online(0|1)
detect_consoles() {
	{
		[ -f "$LEASES" ] && awk '{ print "L", tolower($2), $3, $4 }' "$LEASES"
		[ -f "$ARP" ] && awk 'NR > 1 && $3 == "0x2" { print "N", tolower($4), $1, "*" }' "$ARP"
	} | awk -v ouif="$OUI_FILE" '
	BEGIN { while ((getline l < ouif) > 0) { sub(/[ \t#].*/, "", l); if (l != "") oui[tolower(l)] = 1 } }
	{
		src = $1; mac = $2; ip = $3; host = $4
		if (mac !~ /^([0-9a-f][0-9a-f]:){5}[0-9a-f][0-9a-f]$/) next
		if (!(mac in seen)) { seen[mac] = 1; order[++n] = mac; IP[mac] = ""; H[mac] = "*"; ON[mac] = 0 }
		if (src == "L") { if (IP[mac] == "" || ip ~ /\./) IP[mac] = ip; if (host != "" && host != "*") H[mac] = host }
		if (src == "N") { ON[mac] = 1; if (IP[mac] == "") IP[mac] = ip }
	}
	END {
		for (i = 1; i <= n; i++) {
			mac = order[i]; how = ""
			if (substr(mac, 1, 8) in oui) how = "oui"
			else if (tolower(H[mac]) ~ /ps5|playstation|ps-5/) how = "hostname"
			if (how != "") print mac, (IP[mac] == "" ? "-" : IP[mac]), H[mac], how, ON[mac]
		}
	}'
}

is_console() { # mac [hostname]
	local mac host
	mac="$(echo "$1" | lower)"; host="$(echo "$2" | lower)"
	grep -qx "$(echo "$mac" | cut -c1-8)" "$OUI_FILE" 2>/dev/null && return 0
	case "$host" in *ps5*|*playstation*|*ps-5*) return 0 ;; esac
	return 1
}

# prints: mac enabled name   (manual "console" sections)
manual_consoles() {
	local i=0 mac en name
	while uci -q get "ps5block.@console[$i]" >/dev/null; do
		mac="$(uci -q get "ps5block.@console[$i].mac" | lower)"
		en="$(uci -q get "ps5block.@console[$i].enabled")"
		name="$(uci -q get "ps5block.@console[$i].name")"
		[ -n "$mac" ] && echo "$mac ${en:-1} $name"
		i=$((i + 1))
	done
}

# MACs that must be blocked in "mac" mode
active_macs() {
	local manual excl
	manual="$(manual_consoles)"
	{
		echo "$manual" | awk '$2 == "1" { print $1 }'
		if [ "$(cfg autodetect 1)" = "1" ]; then
			excl=" $(echo "$manual" | awk '$2 != "1" { printf "%s ", $1 }')"
			detect_consoles | while read -r mac _; do
				case "$excl" in *" $mac "*) ;; *) echo "$mac" ;; esac
			done
		fi
	} | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' | sort -u
}

lan_devices() {
	local n st d nets
	nets="$(uci -q get ps5block.main.lan_iface)"
	[ -n "$nets" ] || nets="lan"
	for n in $nets; do
		st="$(ubus call "network.interface.$n" status 2>/dev/null)"
		d="$(echo "$st" | jsonfilter -q -e '@.l3_device' 2>/dev/null)"
		[ -n "$d" ] || d="$(echo "$st" | jsonfilter -q -e '@.device' 2>/dev/null)"
		[ -n "$d" ] && echo "$d"
	done | sort -u
}

# ----------------------------------------------------------------- dnsmasq --
dnsmasq_sections() { uci -q show dhcp | sed -n "s/^dhcp\.\([^.=]*\)=dnsmasq$/\1/p"; }

dns_sync() { # $1 = 1 to install entries, 0 to remove
	local want="" have s d cur changed=0
	[ "$1" = "1" ] && [ "$(layer dns_block)" = "1" ] && want="$(uci -q get ps5block.main.domain)"
	have="$(cat "$DNS_STATE" 2>/dev/null)"
	for s in $(dnsmasq_sections); do
		cur=" $(uci -q get "dhcp.$s.address") "
		for d in $have; do
			case " $want " in *" $d "*) continue ;; esac
			case "$cur" in *" /$d/ "*) uci -q del_list "dhcp.$s.address=/$d/"; changed=1 ;; esac
		done
		for d in $want; do
			case "$cur" in *" /$d/ "*) ;; *) uci add_list "dhcp.$s.address=/$d/"; changed=1 ;; esac
		done
	done
	if [ -n "$want" ]; then echo "$want" > "$DNS_STATE"; else rm -f "$DNS_STATE"; fi
	if [ "$changed" = "1" ]; then
		uci commit dhcp
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		log "dnsmasq updated"
	fi
}

dns_entry_present() {
	local s d
	d="$(uci -q get ps5block.main.domain | awk '{print $1}')"
	[ -n "$d" ] || return 1
	for s in $(dnsmasq_sections); do
		case " $(uci -q get "dhcp.$s.address") " in *" /$d/ "*) return 0 ;; esac
	done
	return 1
}

dns_test() { # blocked | resolves | error
	local out
	out="$(nslookup "$TEST_HOST" 127.0.0.1 2>&1)"
	if echo "$out" | grep -qiE "NXDOMAIN|can.t find|not found"; then echo blocked
	elif echo "$out" | awk '/^Name:/ {f=1} f && /^Address/ {ok=1} END {exit !ok}'; then echo resolves
	else echo error; fi
}

# ------------------------------------------------------------------ nftables --
nft_set() { # name type "elements"
	if [ -n "$3" ]; then
		printf '\tset %s {\n\t\ttype %s\n\t\telements = { %s }\n\t}\n' "$1" "$2" "$3"
	else
		printf '\tset %s {\n\t\ttype %s\n\t}\n' "$1" "$2"
	fi
}

# IPv4 addresses / subnets that podkop sends entirely through the proxy
podkop_routed() {
	uci -q show podkop 2>/dev/null | grep -E '\.fully_routed_ips=' | sed 's/^[^=]*=//' | tr ' ' '\n' | tr -d "'" |
		grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$' | sort -u
}

# effective strict-DNS scope: all | podkop | off
strict_mode() {
	local v
	if [ "$(cfg mode mac)" = "global" ]; then
		v="$(cfg global_dns_strict 0)"
	else
		v="$(cfg dns_strict auto)"
	fi
	case "$v" in
		1|on|all) echo all ;;
		auto) [ -n "$(podkop_routed)" ] && echo podkop || echo off ;;
		*) echo off ;;
	esac
}

ip_in_list() { # ip "cidr list" -> 0 if ip is inside any entry
	echo "$2" | tr ' ,' '\n\n' | awk -v ip="$1" '
		function n(a,  p) { split(a, p, "."); return ((p[1] * 256 + p[2]) * 256 + p[3]) * 256 + p[4] }
		NF { split($0, c, "/"); bits = (c[2] == "" ? 32 : c[2]); m = 1; for (k = bits; k < 32; k++) m = m * 2
		     if (int(n(ip) / m) == int(n(c[1]) / m)) { found = 1; exit } }
		END { exit !found }'
}

build_ruleset() {
	local mode match devs macs u4 u6 d4 d6 pr
	mode="$(cfg mode mac)"
	devs="$(lan_devices | awk '{ printf "%s\"%s\"", (n++ ? ", " : ""), $0 }')"
	[ -n "$devs" ] || devs='"br-lan"'
	macs="$(active_macs | join_comma)"
	d4="$(echo $DOH4 | tr ' ' '\n' | join_comma)"
	d6="$(echo $DOH6 | tr ' ' '\n' | join_comma)"
	u4="$(cat "$STATE_DIR/upd4" 2>/dev/null)"
	u6="$(cat "$STATE_DIR/upd6" 2>/dev/null)"

	match="iifname @lan_if"
	[ "$mode" = "mac" ] && match="$match ether saddr @consoles"

	echo "table inet $TABLE"
	echo "delete table inet $TABLE"
	echo "table inet $TABLE {"
	nft_set lan_if ifname "$devs"
	nft_set consoles ether_addr "$macs"
	nft_set doh4 ipv4_addr "$d4"
	nft_set doh6 ipv6_addr "$d6"
	nft_set upd4 ipv4_addr "$u4"
	nft_set upd6 ipv6_addr "$u6"
	pr="$(podkop_routed | join_comma)"
	if [ -n "$pr" ]; then
		printf '\tset podkop_routed {\n\t\ttype ipv4_addr\n\t\tflags interval\n\t\tauto-merge\n\t\telements = { %s }\n\t}\n' "$pr"
	else
		printf '\tset podkop_routed {\n\t\ttype ipv4_addr\n\t\tflags interval\n\t}\n'
	fi
	echo ""
	# nat chain before podkop (mangle -150): DNS goes to dnsmasq, never to proxy
	echo "	chain dns_redirect {"
	echo "		type nat hook prerouting priority -160; policy accept;"
	[ "$(layer force_dns)" = "1" ] && \
	echo "		$match meta l4proto { tcp, udp } th dport 53 fib daddr type != local counter redirect to :53 comment \"force_dns\""
	echo "	}"
	echo "	chain block {"
	echo "		type filter hook prerouting priority -170; policy accept;"
	# strict DNS: runs before podkop (-150). NAT redirect always runs at -100,
	# where podkop's tproxy can win for clients it routes completely.
	case "$(strict_mode)" in
		all)    echo "		$match meta l4proto { tcp, udp } th dport 53 fib daddr type != local counter drop comment \"dns_strict\"" ;;
		podkop) echo "		$match ip saddr @podkop_routed meta l4proto { tcp, udp } th dport 53 fib daddr type != local counter drop comment \"dns_strict\"" ;;
	esac
	[ "$(layer block_dot)" = "1" ] && \
	echo "		$match meta l4proto { tcp, udp } th dport 853 counter drop comment \"dot\""
	# port 53 to public resolvers is NOT dropped here: it is redirected to dnsmasq
	# by the nat chain (or dropped by dns_strict above). Everything else (DoH 443,
	# DoQ/HTTP3, custom ports) to known resolvers is dropped.
	if [ "$(layer block_doh)" = "1" ]; then
		echo "		$match ip daddr @doh4 meta l4proto { tcp, udp } th dport != 53 counter drop comment \"doh4\""
		echo "		$match ip6 daddr @doh6 meta l4proto { tcp, udp } th dport != 53 counter drop comment \"doh6\""
	fi
	if [ "$(layer l3_block)" = "1" ]; then
		echo "		$match ip daddr @upd4 counter drop comment \"l3_v4\""
		echo "		$match ip6 daddr @upd6 counter drop comment \"l3_v6\""
	fi
	echo "	}"
	echo "}"
}

nft_counters() { # prints: comment packets
	nft list table inet "$TABLE" 2>/dev/null | awk '
		/comment "/ {
			c = $0; sub(/.*comment "/, "", c); sub(/".*/, "", c)
			p = 0; if (match($0, /packets [0-9]+/)) p = substr($0, RSTART + 8, RLENGTH - 8)
			print c, p
		}'
}

set_count() {
	nft list set inet "$TABLE" "$1" 2>/dev/null | sed -n '/elements/,/}/p' \
		| tr ',{}=' '\n\n\n\n' | grep -cE '^[[:space:]]*[0-9a-fA-F:.]+[[:space:]]*$'
}

# ---------------------------------------------------------------- refresh --
resolve_updates() {
	local tmp p r h srv t
	tmp="$STATE_DIR/resolve.$$"
	mkdir -p "$tmp"
	for p in $PREFIXES; do
		for r in $REGIONS; do
			h="${p}${r}01.ps5.update.playstation.net"
			(
				for srv in $(cfg_resolvers); do
					for t in a aaaa; do
						nslookup -type=$t "$h" "$srv" 2>/dev/null
					done
				done | awk '/^Name:/ { f = 1; next }
					f && /^Address/ { sub(/^Address[ 0-9]*:[ \t]*/, ""); split($0, a, " "); print a[1] }' > "$tmp/$h"
			) &
		done
	done
	wait
	cat "$tmp"/* 2>/dev/null | sort -u
	rm -rf "$tmp"
}

cfg_resolvers() {
	local r
	r="$(uci -q get ps5block.main.resolver)"
	echo "${r:-1.1.1.1 8.8.8.8}"
}

rules_sig() { echo "$(strict_mode) $(podkop_routed | join_comma)"; }

sync_consoles() {
	local new old
	table_exists || return 0
	# podkop routing changed -> rebuild the whole table
	if [ "$(rules_sig)" != "$(cat "$STATE_DIR/sig" 2>/dev/null)" ]; then
		build_ruleset > "$STATE_DIR/ruleset.nft" && nft -f "$STATE_DIR/ruleset.nft" 2> "$STATE_DIR/error" && {
			rm -f "$STATE_DIR/error"; rules_sig > "$STATE_DIR/sig"
			active_macs | join_comma > "$STATE_DIR/consoles"
			log "podkop routing changed, rules rebuilt (strict DNS: $(strict_mode))"
		}
		return 0
	fi
	new="$(active_macs | join_comma)"
	old="$(cat "$STATE_DIR/consoles" 2>/dev/null)"
	[ "$new" = "$old" ] && return 0
	{
		echo "flush set inet $TABLE consoles"
		[ -n "$new" ] && echo "add element inet $TABLE consoles { $new }"
	} | nft -f - && echo "$new" > "$STATE_DIR/consoles" && log "consoles: ${new:-none}"
	return 0
}

do_refresh() {
	local ips v4 v6
	[ "$(cfg enabled 0)" = "1" ] || return 0
	mkdir -p "$STATE_DIR"
	sync_consoles
	[ "$(layer l3_block)" = "1" ] || return 0
	ips="$(resolve_updates)"
	v4="$(echo "$ips" | valid_ip4 | join_comma)"
	v6="$(echo "$ips" | valid_ip6 | join_comma)"
	if [ -z "$v4$v6" ]; then
		log "refresh: could not resolve update servers, keeping previous list"
		return 0
	fi
	if table_exists; then
		if ! {
			[ -n "$v4" ] && { echo "flush set inet $TABLE upd4"; echo "add element inet $TABLE upd4 { $v4 }"; }
			[ -n "$v6" ] && { echo "flush set inet $TABLE upd6"; echo "add element inet $TABLE upd6 { $v6 }"; }
		} | nft -f - 2>/dev/null; then
			log "refresh: nft rejected the address list, keeping previous list"
			return 1
		fi
	fi
	# cache only what nft accepted, so a bad answer can never break apply
	[ -n "$v4" ] && echo "$v4" > "$STATE_DIR/upd4"
	[ -n "$v6" ] && echo "$v6" > "$STATE_DIR/upd6"
	date +%s > "$STATE_DIR/refreshed"
	log "refresh: update server list: v4=$(echo "$v4" | tr ',' '\n' | grep -c .) v6=$(echo "$v6" | tr ',' '\n' | grep -c .)"
}

# public unicast IPv4 only (no private/CGNAT/fake-ip/multicast)
valid_ip4() {
	awk -F. 'NF == 4 && $0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $1 <= 255 && $2 <= 255 && $3 <= 255 && $4 <= 255 {
		if ($1 == 0 || $1 == 10 || $1 == 127 || $1 >= 224) next
		if ($1 == 169 && $2 == 254) next
		if ($1 == 172 && $2 >= 16 && $2 <= 31) next
		if ($1 == 192 && $2 == 168) next
		if ($1 == 198 && ($2 == 18 || $2 == 19)) next
		if ($1 == 100 && $2 >= 64 && $2 <= 127) next
		print }'
}

# global unicast IPv6 only, syntactically valid
valid_ip6() {
	awk '{
		a = tolower($0)
		if (a !~ /^[0-9a-f:]+$/) next
		if (a ~ /:::/ || a ~ /^:[^:]/ || a ~ /[^:]:$/) next
		n = gsub(/::/, "::", a); if (n > 1) next
		g = split(a, p, ":"); groups = 0
		for (i = 1; i <= g; i++) { if (length(p[i]) > 4) next; if (p[i] != "") groups++ }
		if ((n == 0 && groups != 8) || groups > 7 && n == 1) next
		if (a !~ /^[23]/) next
		print a }'
}

# ------------------------------------------------------------------- cron --
cron_sync() { # $1 = 1 install, 0 remove
	local i want cur
	i="$(cfg refresh_interval 20)"
	case "$i" in ''|*[!0-9]*) i=20 ;; esac
	[ "$i" -lt 5 ] && i=5
	if [ "$i" -ge 60 ]; then want="$((i % 60)) */$(( i / 60 > 23 ? 23 : i / 60 )) * * *"; else want="*/$i * * * *"; fi
	want="$want /usr/sbin/ps5block refresh >/dev/null 2>&1 $CRON_TAG"
	[ "$1" = "1" ] || want=""
	touch "$CRON_FILE"
	cur="$(grep -F "$CRON_TAG" "$CRON_FILE")"
	[ "$cur" = "$want" ] && return 0
	{ grep -vF "$CRON_TAG" "$CRON_FILE"; [ -n "$want" ] && echo "$want"; } > "$CRON_FILE.ps5block"
	mv "$CRON_FILE.ps5block" "$CRON_FILE"
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
}

# ------------------------------------------------------------ apply / stop --
do_apply() {
	mkdir -p "$STATE_DIR"
	rm -f "$STATE_DIR/error"
	if [ "$(cfg enabled 0)" != "1" ]; then
		do_teardown
		return 0
	fi
	command -v nft >/dev/null 2>&1 || { echo "nft not found" > "$STATE_DIR/error"; log "ERROR: nft not found"; return 1; }

	dns_sync 1
	active_macs | join_comma > "$STATE_DIR/consoles"
	build_ruleset > "$STATE_DIR/ruleset.nft"
	if ! nft -f "$STATE_DIR/ruleset.nft" 2> "$STATE_DIR/error"; then
		# self-heal: drop cached L3 list and try once more
		if [ -s "$STATE_DIR/upd4" ] || [ -s "$STATE_DIR/upd6" ]; then
			log "rules rejected, retrying without cached update server list"
			rm -f "$STATE_DIR/upd4" "$STATE_DIR/upd6" "$STATE_DIR/refreshed"
			build_ruleset > "$STATE_DIR/ruleset.nft"
		fi
		if ! nft -f "$STATE_DIR/ruleset.nft" 2> "$STATE_DIR/error"; then
			log "ERROR: failed to load rules: $(head -n 3 "$STATE_DIR/error" | tr '\n' ' ')"
			return 1
		fi
	fi
	rm -f "$STATE_DIR/error"
	rules_sig > "$STATE_DIR/sig"
	cron_sync 1
	log "enabled: mode=$(cfg mode mac) consoles=$(cat "$STATE_DIR/consoles")"

	# fill L3 list in the background if it is missing or older than the interval
	if [ "$(layer l3_block)" = "1" ]; then
		local age now last
		now="$(date +%s)"; last="$(cat "$STATE_DIR/refreshed" 2>/dev/null || echo 0)"
		age=$(( now - last ))
		[ "$age" -gt $(( $(cfg refresh_interval 20) * 60 )) ] && \
			( QUIET=1 /usr/sbin/ps5block refresh >/dev/null 2>&1 & )
	fi
	return 0
}

do_stop() { # runtime only: remove nft table, keep config and dnsmasq entries
	table_exists && nft delete table inet "$TABLE"
	return 0
}

do_teardown() { # full: nft + dnsmasq entries + cron
	do_stop
	dns_sync 0
	cron_sync 0
	rm -f "$STATE_DIR/consoles" "$STATE_DIR/ruleset.nft" "$STATE_DIR/sig"
	log "disabled"
}

# ------------------------------------------------------------ console cfg --
console_set() { # mac enabled(1|0|remove) [name]
	local mac="$1" en="$2" name="$3" i=0 found=""
	mac="$(echo "$mac" | lower)"
	valid_mac "$mac" || { echo "invalid MAC: $1" >&2; return 1; }
	while uci -q get "ps5block.@console[$i]" >/dev/null; do
		[ "$(uci -q get "ps5block.@console[$i].mac" | lower)" = "$mac" ] && { found="$i"; break; }
		i=$((i + 1))
	done
	if [ "$en" = "remove" ]; then
		[ -n "$found" ] && uci delete "ps5block.@console[$found]"
	else
		if [ -z "$found" ]; then
			uci add ps5block console >/dev/null
			found=-1
		fi
		uci set "ps5block.@console[$found].mac=$mac"
		uci set "ps5block.@console[$found].enabled=${en:-1}"
		[ -n "$name" ] && uci set "ps5block.@console[$found].name=$name"
	fi
	uci commit ps5block
}

# ------------------------------------------------------------------ status --
status_json() {
	local mode enabled applied m4 m6 st tmp_det tmp_man act
	mode="$(cfg mode mac)"; enabled="$(cfg enabled 0)"
	applied=0; table_exists && applied=1

	json_init
	json_add_string version "$VERSION"
	json_add_boolean enabled "$enabled"
	json_add_string mode "$mode"
	json_add_boolean autodetect "$(cfg autodetect 1)"
	json_add_boolean applied "$applied"
	json_add_string error "$(head -c 400 "$STATE_DIR/error" 2>/dev/null)"

	# consoles: merge detected + manual
	tmp_det="$(detect_consoles)"
	tmp_man="$(manual_consoles)"
	act=" $(active_macs | tr '\n' ' ') "
	json_add_int detected "$(echo "$tmp_det" | grep -c .)"
	local merged
	merged="$({
		echo "$tmp_det" | awk 'NF { print "D", $0 }'
		echo "$tmp_man" | awk 'NF { print "M", $0 }'
	} | awk '
		$1 == "D" { m = $2; if (!(m in s)) { s[m] = 1; o[++n] = m }; ip[m] = $3; h[m] = $4; how[m] = $5; on[m] = $6 }
		$1 == "M" { m = $2; if (!(m in s)) { s[m] = 1; o[++n] = m }; man[m] = 1; men[m] = $3
			nm = ""; for (i = 4; i <= NF; i++) nm = nm (i > 4 ? " " : "") $i; name[m] = nm }
		END { for (i = 1; i <= n; i++) { m = o[i]
			printf "%s|%s|%s|%s|%s|%s|%s|%s\n", m, (ip[m] == "" ? "-" : ip[m]), (h[m] == "" ? "*" : h[m]), how[m], (on[m] == "" ? 0 : on[m]), (man[m] ? 1 : 0), (men[m] == "" ? 1 : men[m]), name[m] } }')"
	json_add_array consoles
	while IFS='|' read -r m ip h how on man men nm; do
		[ -n "$m" ] || continue
		json_add_object
		json_add_string mac "$m"
		json_add_string ip "$ip"
		json_add_string hostname "$h"
		json_add_string name "$nm"
		json_add_string detected_by "${how:-manual}"
		json_add_boolean online "$on"
		json_add_boolean manual "$man"
		json_add_boolean manual_enabled "$men"
		case "$act" in *" $m "*) json_add_boolean active 1 ;; *) json_add_boolean active 0 ;; esac
		json_close_object
	done <<EOF
$merged
EOF
	json_close_array

	json_add_array lan_devices
	for d in $(lan_devices); do json_add_string "" "$d"; done
	json_close_array

	# layers
	local cnt
	cnt="$(nft_counters)"
	pk() { echo "$cnt" | awk -v c="$1" '$1 == c { s += $2 } END { print s + 0 }'; }
	json_add_object layers
		json_add_object dns
			json_add_boolean enabled "$(layer dns_block)"
			dns_entry_present && json_add_boolean active 1 || json_add_boolean active 0
			if [ "$enabled" = "1" ]; then json_add_string test "$(dns_test)"; else json_add_string test "skipped"; fi
		json_close_object
		json_add_object force_dns
			json_add_boolean enabled "$(layer force_dns)"
			echo "$cnt" | grep -q '^force_dns ' && json_add_boolean active 1 || json_add_boolean active 0
			json_add_int packets "$(pk force_dns)"
		json_close_object
		json_add_object dns_strict
			local sm
			sm="$(strict_mode)"
			json_add_string scope "$sm"
			if [ "$mode" = "global" ]; then json_add_string setting "$(cfg global_dns_strict 0)"; else json_add_string setting "$(cfg dns_strict auto)"; fi
			[ "$sm" != "off" ] && json_add_boolean enabled 1 || json_add_boolean enabled 0
			echo "$cnt" | grep -q '^dns_strict ' && json_add_boolean active 1 || json_add_boolean active 0
			json_add_int packets "$(pk dns_strict)"
			json_add_array podkop_routed
			for p in $(podkop_routed); do json_add_string "" "$p"; done
			json_close_array
		json_close_object
		json_add_object dot
			json_add_boolean enabled "$(layer block_dot)"
			echo "$cnt" | grep -q '^dot ' && json_add_boolean active 1 || json_add_boolean active 0
			json_add_int packets "$(pk dot)"
		json_close_object
		json_add_object doh
			json_add_boolean enabled "$(layer block_doh)"
			echo "$cnt" | grep -q '^doh4 ' && json_add_boolean active 1 || json_add_boolean active 0
			json_add_int packets "$(( $(pk doh4) + $(pk doh6) ))"
			json_add_int v4 "$(set_count doh4)"
			json_add_int v6 "$(set_count doh6)"
		json_close_object
		json_add_object l3
			json_add_boolean enabled "$(layer l3_block)"
			echo "$cnt" | grep -q '^l3_v4 ' && json_add_boolean active 1 || json_add_boolean active 0
			json_add_int packets "$(( $(pk l3_v4) + $(pk l3_v6) ))"
			json_add_int v4 "$(set_count upd4)"
			json_add_int v6 "$(set_count upd6)"
			json_add_int refreshed "$(cat "$STATE_DIR/refreshed" 2>/dev/null || echo 0)"
			json_add_int interval "$(cfg refresh_interval 20)"
		json_close_object
	json_close_object

	# integrations
	local tables
	tables="$(nft list tables 2>/dev/null)"
	json_add_object integrations
		json_add_object podkop
			[ -x /etc/init.d/podkop ] && json_add_boolean installed 1 || json_add_boolean installed 0
			{ echo "$tables" | grep -qi podkop || pidof sing-box >/dev/null; } && json_add_boolean running 1 || json_add_boolean running 0
		json_close_object
		json_add_object zapret
			{ [ -x /etc/init.d/zapret ] || [ -x /etc/init.d/zapret2 ]; } && json_add_boolean installed 1 || json_add_boolean installed 0
			{ echo "$tables" | grep -qi zapret || pidof nfqws >/dev/null || pidof nfqws2 >/dev/null; } && json_add_boolean running 1 || json_add_boolean running 0
		json_close_object
		json_add_object doh_proxy
			[ -x /etc/init.d/https-dns-proxy ] && json_add_boolean installed 1 || json_add_boolean installed 0
			pidof https-dns-proxy >/dev/null && json_add_boolean running 1 || json_add_boolean running 0
		json_close_object
		json_add_object adguardhome
			{ [ -x /etc/init.d/adguardhome ] || [ -x /etc/init.d/AdGuardHome ]; } && json_add_boolean installed 1 || json_add_boolean installed 0
			pidof AdGuardHome >/dev/null && json_add_boolean running 1 || json_add_boolean running 0
		json_close_object
	json_close_object

	# warnings (codes, translated in LuCI)
	json_add_array warnings
	if [ "$enabled" = "1" ]; then
		[ "$mode" = "mac" ] && [ "$act" = "  " ] && json_add_string "" "no_consoles"
		[ "$(echo "$tmp_det" | grep -c .)" -gt 1 ] && json_add_string "" "multiple_consoles"
		[ "$applied" = "0" ] && json_add_string "" "not_applied"
		if uci -q show podkop >/dev/null 2>&1; then
			uci -q show podkop | grep -qi playstation && json_add_string "" "podkop_domains"
			local routed sm2
			routed="$(podkop_routed)"; sm2="$(strict_mode)"
			if [ -n "$routed" ]; then
				while read -r m ip _; do
					[ -n "$m" ] && [ "$ip" != "-" ] || continue
					case "$ip" in *.*.*.*) ;; *) continue ;; esac
					[ "$mode" = "global" ] || case "$act" in *" $m "*) ;; *) continue ;; esac
					ip_in_list "$ip" "$routed" || continue
					if [ "$sm2" = "off" ]; then json_add_string "" "podkop_ip:$ip"; else json_add_string "" "podkop_strict:$ip"; fi
				done <<EOF
$tmp_det
EOF
			fi
		fi
		pidof AdGuardHome >/dev/null && json_add_string "" "adguard"
		[ "$(layer dns_block)" = "1" ] && ! dns_entry_present && json_add_string "" "dns_missing"
	fi
	json_close_array

	json_dump
}

status_text() {
	local st
	st="$(status_json)"
	echo "== ps5block $VERSION =="
	echo "Enabled:   $(echo "$st" | jsonfilter -e '@.enabled')   mode: $(echo "$st" | jsonfilter -e '@.mode')   rules loaded: $(echo "$st" | jsonfilter -e '@.applied')"
	echo "LAN:       $(lan_devices | tr '\n' ' ')"
	echo "Consoles (mac ip hostname detected_by online / blocked):"
	echo "$st" | jsonfilter -e '@.consoles[*]' | while read -r c; do
		printf '  %s  %-15s  %-20s  %-8s  online=%s  blocked=%s\n' \
			"$(echo "$c" | jsonfilter -e '@.mac')" "$(echo "$c" | jsonfilter -e '@.ip')" \
			"$(echo "$c" | jsonfilter -e '@.hostname')" "$(echo "$c" | jsonfilter -e '@.detected_by')" \
			"$(echo "$c" | jsonfilter -e '@.online')" "$(echo "$c" | jsonfilter -e '@.active')"
	done
	for l in dns force_dns dot doh l3; do
		printf '  %-10s enabled=%s active=%s packets=%s\n' "$l" \
			"$(echo "$st" | jsonfilter -e "@.layers.$l.enabled")" "$(echo "$st" | jsonfilter -e "@.layers.$l.active")" \
			"$(echo "$st" | jsonfilter -q -e "@.layers.$l.packets")"
	done
	echo "DNS test:  $(echo "$st" | jsonfilter -e '@.layers.dns.test')"
	echo "L3 list:   v4=$(echo "$st" | jsonfilter -e '@.layers.l3.v4') v6=$(echo "$st" | jsonfilter -e '@.layers.l3.v6')"
	echo "Warnings:  $(echo "$st" | jsonfilter -e '@.warnings[*]' | tr '\n' ' ')"
	[ -s "$STATE_DIR/error" ] && echo "Error:     $(cat "$STATE_DIR/error")"
}

usage() {
	cat <<EOF
ps5block $VERSION - PlayStation 5 system update blocker

Usage: ps5block <command>
  enable | disable            turn blocking on/off (saved in /etc/config/ps5block)
  mode <mac|global>           block consoles only, or every LAN client
  apply                       (re)apply current configuration
  status                      human-readable status
  status-json                 status for LuCI/scripts
  detect                      list detected PlayStation consoles
  add <MAC> [name]            add a console manually
  exclude <MAC>               exclude a console from auto-detection
  remove <MAC>                remove a manually added console
  refresh                     refresh update server IP list (L3) and consoles
  stop                        remove runtime rules only (used by init)
  teardown                    remove everything (rules, dnsmasq entries, cron)
EOF
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
	enable)      uci set ps5block.main.enabled=1; uci commit ps5block; with_lock do_apply ;;
	disable)     uci set ps5block.main.enabled=0; uci commit ps5block; with_lock do_apply ;;
	mode)        case "$1" in mac|global) uci set ps5block.main.mode="$1"; uci commit ps5block; with_lock do_apply ;; *) usage; exit 1 ;; esac ;;
	apply|start|reload) with_lock do_apply ;;
	stop)        with_lock do_stop ;;
	teardown)    with_lock do_teardown ;;
	refresh)     with_lock do_refresh ;;
	status)      status_text ;;
	status-json) status_json ;;
	detect)      detect_consoles | awk 'BEGIN { print "MAC               IP               HOSTNAME             BY       ONLINE" }
	                 { printf "%-17s %-16s %-20s %-8s %s\n", $1, $2, $3, $4, $5 }' ;;
	add)         console_set "$1" 1 "$2" && with_lock do_apply ;;
	exclude)     console_set "$1" 0 && with_lock do_apply ;;
	remove)      console_set "$1" remove && with_lock do_apply ;;
	console-set) console_set "$@" && with_lock do_apply ;;
	is-console)  is_console "$1" "$2" ;;
	sync)        with_lock sync_consoles ;;
	ruleset)     build_ruleset ;;
	version)     echo "$VERSION" ;;
	*)           usage; [ -z "$cmd" ] || [ "$cmd" = "help" ] || exit 1 ;;
esac
