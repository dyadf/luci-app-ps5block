
config ps5block 'main'
	option enabled '0'
	# mac    - block only PlayStation consoles (by MAC address)
	# global - block for every client of the LAN networks below
	option mode 'mac'
	option autodetect '1'
	list lan_iface 'lan'

	# Layer 1: dnsmasq answers NXDOMAIN for update domains (always network-wide)
	option dns_block '1'

	# Layers for "mac" mode (consoles only)
	option force_dns '1'
	# auto - drop external DNS only for consoles that podkop routes completely
	#        (podkop's tproxy would otherwise take DNS before the redirect)
	option dns_strict 'auto'
	# force the console's DNS onto specific server(s) instead of the router's
	# dnsmasq (empty = router). Add one or more IPs to make the console resolve
	# through them, overriding podkop/AdGuard; with several, queries are spread
	# across them. Note: with a non-router server the built-in dnsmasq block
	# does not apply to the console - the update block then relies on L3/DoT/DoH
	# or that server's own filtering. Make sure the server(s) are reachable.
	#list dns_server '1.1.1.1'
	#list dns_server '8.8.8.8'
	option block_dot '1'
	option block_doh '1'
	option l3_block '1'

	# Layers for "global" mode (every LAN client) - safer defaults
	option global_force_dns '1'
	option global_dns_strict '0'
	option global_block_dot '0'
	option global_block_doh '0'
	option global_l3_block '0'

	option refresh_interval '20'
	# TCP port the console's homebrew payload loader listens on
	option payload_port '9021'

	# What to block (DNS layer):
	#   updates - system software updates only (default; games/PSN keep working)
	#   all     - every PlayStation/PSN server (updates, downloads, store, social)
	#   custom  - only the domains listed below
	option blocklist 'updates'
	# Extra domains to block on top of the preset (blocked with all subdomains)
	list domain 'ps5.update.playstation.net'
	list resolver '1.1.1.1'
	list resolver '8.8.8.8'

# Consoles added by hand (or excluded from auto-detection with enabled '0')
#config console
#	option name 'PS5 living room'
#	option mac 'aa:bb:cc:dd:ee:ff'
#	option enabled '1'
