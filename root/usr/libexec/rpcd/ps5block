#!/bin/sh
# rpcd backend for luci-app-ps5block

. /usr/share/libubox/jshn.sh

ok() { json_init; json_add_int result "${1:-0}"; [ -n "$2" ] && json_add_string error "$2"; json_dump; }

case "$1" in
list)
	echo '{ "status": {}, "apply": {}, "refresh": {}, "toggle": { "enabled": true }, "console": { "mac": "str", "action": "str", "name": "str" } }'
	;;
call)
	case "$2" in
	status)
		/usr/sbin/ps5block status-json
		;;
	apply)
		/usr/sbin/ps5block apply >/dev/null 2>&1
		ok $?
		;;
	refresh)
		( /usr/sbin/ps5block refresh >/dev/null 2>&1 & )
		ok 0
		;;
	toggle)
		read -r input
		json_load "$input"; json_get_var en enabled
		case "$en" in 1|true) en=1 ;; *) en=0 ;; esac
		uci set ps5block.main.enabled="$en"
		uci commit ps5block
		/usr/sbin/ps5block apply >/dev/null 2>&1
		ok $?
		;;
	console)
		read -r input
		json_load "$input"
		json_get_var mac mac; json_get_var action action; json_get_var name name
		case "$action" in
			include) a=1 ;; exclude) a=0 ;; remove) a=remove ;;
			*) ok 1 "bad action"; exit 0 ;;
		esac
		err="$(/usr/sbin/ps5block console-set "$mac" "$a" "$name" 2>&1 >/dev/null)"
		ok $? "$err"
		;;
	esac
	;;
esac
